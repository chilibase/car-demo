{
  "name": "car-demo-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "author": "Michal Rakus",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "linkLib": "pnpm link @michalrakus/x-nest-server-lib",
    "buildAndPackLib": "pnpm --prefix ../../chilibase/backend run buildAndPack",
    "installLib": "pnpm install ../../chilibase/backend/chilibase-backend-0.6.3.tgz",
    "cs": "pnpm run copy-common && pnpm run start",
    "bl": "pnpm run buildAndPackLib && pnpm run installLib",
    "sl": "pnpm run bl && pnpm run cs",
    "copy-common": "pnpm dlx shx rm -rf src/common && pnpm dlx shx cp -r ../frontend/src/common ./src/common",
    "preinstall": "npx only-allow pnpm"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@chilibase/backend": "file:../../chilibase/backend/chilibase-backend-0.6.3.tgz",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/typeorm": "^11.0.3",
    "angular-expressions": "^1.7.0",
    "docxtemplater": "^3.71.0",
    "exceljs": "^4.4.0",
    "jwks-rsa": "^3.2.2",
    "line-reader": "^0.4.0",
    "lodash": "^4.18.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "pg-query-stream": "^4.17.1",
    "pizzip": "^3.3.0",
    "postgres-interval": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "jest": "29.7.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
