{
  "name": "car-demo-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "author": "Michal Rakus",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist tsconfig.build.tsbuildinfo",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "linkLib": "pnpm link @michalrakus/x-nest-server-lib",
    "buildAndPackLib": "pnpm --prefix ../../chilibase/backend run buildAndPack",
    "installLib": "pnpm install ../../chilibase/backend/chilibase-backend-0.7.0.tgz",
    "cs": "pnpm run copy-common && pnpm run start",
    "bl": "pnpm run buildAndPackLib && pnpm run installLib",
    "sl": "pnpm run bl && pnpm run cs",
    "copy-common": "pnpm dlx shx rm -rf src/common && pnpm dlx shx cp -r ../frontend/src/common ./src/common",
    "preinstall": "npx only-allow pnpm"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=11 <12"
  },
  "dependencies": {
    "@chilibase/backend": "^0.7.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/typeorm": "^12.0.2",
    "angular-expressions": "^1.7.0",
    "docxtemplater": "^3.71.0",
    "exceljs": "^4.4.0",
    "jwks-rsa": "^4.1.0",
    "line-reader": "^0.4.0",
    "lodash": "^4.18.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "pg-query-stream": "^4.17.1",
    "pizzip": "^3.3.0",
    "postgres-interval": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "extensionsToTreatAsEsm": [".ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": ["ts-jest", {"useESM": true}]
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
