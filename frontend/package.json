{
  "name": "car-demo-frontend",
  "version": "1.0.0",
  "type": "module",
  "author": "Michal Rakus",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "buildAndPackLib": "pnpm --prefix ../../chilibase/frontend run buildAndPack",
    "installLib": "pnpm install ../../chilibase/frontend/chilibase-frontend-0.7.1.tgz",
    "bl": "pnpm run buildAndPackLib && pnpm run installLib",
    "sl": "pnpm run bl && pnpm run dev",
    "preinstall": "npx only-allow pnpm"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=11 <12"
  },
  "dependencies": {
    "@chilibase/frontend": "^0.7.1",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.9",
    "quill": "^2.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
